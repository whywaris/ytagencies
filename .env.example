NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Google Analytics 4 measurement ID (G-E6X061VCPX). Safe to set now: GA runs only on Vercel
# Production (VERCEL_ENV), never locally or on previews, and never for signed-in users.
NEXT_PUBLIC_GA_ID=
# "true" lets Google index the site. Set it only at launch, on Production only. Anything else:
# every response is noindex and robots.txt blocks everything.
ALLOW_INDEXING=
SITE_URL=
EMAIL_FROM=
ADMIN_EMAIL=
CLAIM_TOKEN_SECRET=
YOUTUBE_API_KEY=
# Sponsored slots (lib/ranking.ts). Off unless exactly "true"; the data and tables are kept.
SPONSORED_ENABLED=false
# Lemon Squeezy (docs/LAUNCH.md → Lemon Squeezy). Get Pro creates a checkout only when all of these
# are set; otherwise it says "temporarily unavailable" and emails ADMIN_EMAIL.
# Exactly "true" turns checkout on.
PAYMENTS_ENABLED=
# Lemon Squeezy → Settings → API → create an API key. Keys made in test mode are test keys.
LEMONSQUEEZY_API_KEY=
# Lemon Squeezy → Settings → Stores → your store's ID (a number).
LEMONSQUEEZY_STORE_ID=
# Lemon Squeezy → Products → "YT Agencies Pro" → the monthly and yearly variant IDs (numbers).
LEMONSQUEEZY_VARIANT_MONTHLY=
LEMONSQUEEZY_VARIANT_YEARLY=
# Lemon Squeezy → Settings → Webhooks → the signing secret you set on the endpoint.
# Endpoint URL: https://ytagencies.com/api/webhooks/lemonsqueezy
LEMONSQUEEZY_WEBHOOK_SECRET=
# "true" creates checkouts in test mode (test key, test cards); "false" or unset = live.
LEMONSQUEEZY_TEST_MODE=
CRON_SECRET=
# Cloudflare R2 image host(s) for agency logos and guide cover links, comma-separated.
# Opens next/image and the CSP img-src to them. e.g. media.ytagencies.com
MEDIA_HOSTS=
