NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Cloudflare Turnstile. Locally and on previews Cloudflare's test keys are fine
# (1x00000000000000000000AA / 1x0000000000000000000000000000000AA). Production needs the real
# keys: a production build fails on a missing or test key (1x0000…, 2x0000…, 3x0000…).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Google Analytics 4 measurement ID (G-E6X061VCPX). Safe to set now: GA runs only on Vercel
# Production (VERCEL_ENV), never locally or on previews, and never for signed-in users.
NEXT_PUBLIC_GA_ID=
# "true" lets Google index the site. Set it only at launch, on Production only. Anything else:
# every response is noindex and robots.txt blocks everything.
ALLOW_INDEXING=
SITE_URL=
EMAIL_FROM=
ADMIN_EMAIL=
CLAIM_TOKEN_SECRET=
YOUTUBE_API_KEY=
# Sponsored slots (lib/ranking.ts). Off unless exactly "true"; the data and tables are kept.
SPONSORED_ENABLED=false
# Creem (docs/LAUNCH.md → Creem). Get Pro creates a checkout only when all of these are set;
# otherwise it says "temporarily unavailable" and emails ADMIN_EMAIL.
# Exactly "true" turns checkout on.
PAYMENTS_ENABLED=
# Creem dashboard → Developers → API keys. creem_test_… with CREEM_TEST_MODE=true; live key without.
CREEM_API_KEY=
# Creem dashboard → Developers → Webhooks → your endpoint's signing secret.
# Endpoint URL: https://ytagencies.com/api/billing/webhook
CREEM_WEBHOOK_SECRET=
# Creem dashboard → Products → "YT Agencies Pro" monthly / yearly → product id (prod_…).
CREEM_PRODUCT_PRO_MONTHLY=
CREEM_PRODUCT_PRO_YEARLY=
# "true" = https://test-api.creem.io (test keys); unset = https://api.creem.io (live keys).
CREEM_TEST_MODE=
CRON_SECRET=
# Cloudflare R2 image host(s) for agency logos and guide cover links, comma-separated.
# Opens next/image and the CSP img-src to them. e.g. media.ytagencies.com
MEDIA_HOSTS=
